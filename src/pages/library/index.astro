---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import LibraryBrowser from '../../components/react/LibraryBrowser'
import IngestForm from '../../components/react/IngestForm.tsx'
import { toCardData, familyIdOf } from '../../lib/cards'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const families = await getCollection('families')
const familyNames = new Map(families.map((f) => [f.id, f.data.name]))
const entries = await getCollection('inspirations', ({ data }) => !data.draft)
const cards = await Promise.all(
  entries.map((e) => toCardData(e, familyNames.get(familyIdOf(e)) ?? familyIdOf(e))),
)
cards.sort((a, b) => a.title.localeCompare(b.title))

const familyMeta = families
  .map((f) => ({ id: f.id, name: f.data.name, order: f.data.order }))
  .sort((a, b) => a.order - b.order)
---

<Base title="library · taste-vault" description="Every aesthetic reference in the vault.">
  <section class="library-page">
    <!-- Asymmetric intro: the statement takes the wide track, a count aside
         sits on the narrow rail — breaks the centred single-column template. -->
    <div class="library-intro">
      <div class="library-intro-main">
        <h1 class="library-title text-h1 tracking-h1 leading-h1 font-heading">Library</h1>
        <p class="library-lede">
          {cards.length} references across {familyMeta.length} aesthetic families. Each one
          carries the vocabulary, palette, and guardrails a generator needs to reproduce it.
          Shortlist what fits, send it to the prompt builder, and the brief assembles itself.
        </p>
      </div>
      <aside class="library-count" aria-label="library at a glance">
        <p class="library-count-num">{cards.length}</p>
        <p class="library-count-label">references · {familyMeta.length} families</p>
      </aside>
    </div>
    <IngestForm client:load families={familyMeta} />
    <LibraryBrowser client:load cards={cards} families={familyMeta} />
  </section>
</Base>

<style>
  .library-page {
    display: flex;
    flex-direction: column;
    gap: calc(var(--tv-space-unit) * 12);
  }
  .library-intro {
    display: grid;
    grid-template-columns: minmax(0, 2.5fr) minmax(0, 1fr);
    gap: calc(var(--tv-space-unit) * 10);
    align-items: end;
  }
  .library-intro-main {
    display: flex;
    flex-direction: column;
    gap: calc(var(--tv-space-unit) * 4);
    max-width: var(--tv-measure);
  }
  .library-title {
    margin: 0;
  }
  .library-lede {
    margin: 0;
    color: var(--tv-fg-muted);
    line-height: var(--tv-body-leading);
  }
  /* count aside — a large numeral anchors the hierarchy the bare layout lacked */
  .library-count {
    border: var(--tv-border-width) solid var(--tv-border);
    border-radius: var(--tv-radius);
    background: var(--tv-surface);
    padding: calc(var(--tv-space-unit) * 4);
    display: flex;
    flex-direction: column;
    gap: calc(var(--tv-space-unit) * 1);
  }
  .library-count-num {
    margin: 0;
    font-family: var(--tv-font-heading);
    font-size: calc(var(--tv-h1-size) * 0.5);
    font-weight: var(--tv-h1-weight);
    letter-spacing: var(--tv-h1-tracking);
    line-height: 1;
    color: var(--tv-accent);
  }
  .library-count-label {
    margin: 0;
    font-family: var(--tv-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tv-fg-muted);
  }
  @media (max-width: 768px) {
    .library-intro {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
