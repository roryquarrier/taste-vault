---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import PromptBuilder from '../components/react/PromptBuilder.tsx'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const families = await getCollection('families')
const entries = await getCollection('inspirations', ({ data }) => !data.draft)

const familyData = families.map(f => ({
  id: f.id,
  name: f.data.name,
  description: f.data.description,
  vocabulary: f.data.vocabulary,
  guardrails: f.data.guardrails,
})).sort((a, b) => families.find(f => f.id === a.id)!.data.order - families.find(f => f.id === b.id)!.data.order)

const inspirationData = entries.map(e => {
  const famRef = e.data.family as unknown as { id: string } | string
  const famId = typeof famRef === 'string' ? famRef : famRef?.id ?? ''
  return {
    id: e.id,
    title: e.data.title,
    familyId: famId,
    familyName: families.find(f => f.id === famId)?.data.name ?? '',
    description: e.data.description,
    vocabulary: e.data.vocabulary,
    intent: e.data.intent,
    imageRecipe: {
      subject: e.data.imageRecipe.subject,
      medium: e.data.imageRecipe.medium,
      palette: e.data.imageRecipe.palette,
      aspect: e.data.imageRecipe.aspect,
    },
  }
})
---

<Base title="generate · taste-vault" description="Build a master design prompt from the library.">
  <section class="generate-page">
    <!-- Asymmetric intro: statement on the wide track, a compact aside on the
         narrow rail carrying the loop position. Breaks the centred-single-column
         template and gives the bare wrapper real structure. -->
    <div class="generate-intro">
      <div class="generate-intro-main">
        <h1 class="generate-title text-h1 tracking-h1 leading-h1 font-heading">Generate</h1>
        <p class="generate-lede">
          Step two of the loop. Fill in your product details and pick aesthetic directions
          from the <a href={`${base}/library`} class="generate-link">library</a> — the builder
          folds them into a single master brief with explicit instructions to avoid the usual
          AI tells. Copy it into your AI frontend tool and get five committed variations in one shot.
        </p>
      </div>
      <aside class="generate-loop" aria-label="where you are in the loop">
        <p class="generate-loop-mark">02 / 03</p>
        <p class="generate-loop-line">library → <span class="generate-loop-here">generate</span> → reference</p>
      </aside>
    </div>
    <PromptBuilder client:load families={familyData} inspirations={inspirationData} />
  </section>
</Base>

<style>
  .generate-page {
    display: flex;
    flex-direction: column;
    gap: calc(var(--tv-space-unit) * 12);
  }
  .generate-intro {
    display: grid;
    grid-template-columns: minmax(0, 2.5fr) minmax(0, 1fr);
    gap: calc(var(--tv-space-unit) * 10);
    align-items: end;
  }
  .generate-intro-main {
    display: flex;
    flex-direction: column;
    gap: calc(var(--tv-space-unit) * 4);
    max-width: var(--tv-measure);
  }
  .generate-title {
    margin: 0;
  }
  .generate-lede {
    margin: 0;
    color: var(--tv-fg-muted);
    line-height: var(--tv-body-leading);
  }
  .generate-link {
    color: var(--tv-accent);
    text-decoration: none;
    border-bottom: var(--tv-border-width) solid var(--tv-accent);
  }
  .generate-link:hover {
    opacity: 0.85;
  }
  /* compact loop-position aside — mirrors the spec-sheet voice on the home
     page so the system reads as one design, but smaller and right-aligned */
  .generate-loop {
    border: var(--tv-border-width) solid var(--tv-border);
    border-radius: var(--tv-radius);
    background: var(--tv-surface);
    padding: calc(var(--tv-space-unit) * 4);
    display: flex;
    flex-direction: column;
    gap: calc(var(--tv-space-unit) * 2);
  }
  .generate-loop-mark {
    margin: 0;
    font-family: var(--tv-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tv-accent);
  }
  .generate-loop-line {
    margin: 0;
    font-family: var(--tv-font-mono);
    font-size: 0.75rem;
    line-height: var(--tv-body-leading);
    color: var(--tv-fg-muted);
  }
  .generate-loop-here {
    color: var(--tv-fg);
  }
  @media (max-width: 768px) {
    .generate-intro {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
