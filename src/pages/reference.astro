---
import Base from '../layouts/Base.astro'
import TweaksPanel from '../components/react/TweaksPanel.tsx'
import VariationViewer from '../components/react/VariationViewer.tsx'

const title = 'Design Reference — taste-vault'
const description = 'Connect your generated frontends, preview them live, tune the design tokens, and export the CSS.'
---

<Base title={title} description={description}>
  <!-- Orientation header: what this page is, in one glance -->
  <header class="page-intro">
    <p class="mono-label">taste-vault · reference</p>
    <h1 class="page-intro-title text-h1">Design Reference</h1>
    <p class="page-intro-sub">
      Connect your generated frontends, preview them live, tune the design
      tokens, and export the CSS.
    </p>
  </header>

  <!-- 1 · Connect & Preview -->
  <section class="variation-section">
    <p class="mono-label section-label">1 · Connect &amp; Preview</p>
    <VariationViewer client:visible />
  </section>

  <div class="reference-page">
    <!-- 2 · Token Preview: proves the tokens are live before the panel opens -->
    <section class="body-section">
      <div class="body-content">
        <p class="mono-label section-label">2 · Token Preview</p>
        <div class="stress-block">
          <div class="stress-grid" style="gap: var(--tv-grid-gutter);">
            <!-- COLOR: accent + accent-2 swatches that recompute live -->
            <div class="stress-card stress-color">
              <p class="mono-label">COLOR</p>
              <div class="swatch-row">
                <span class="swatch swatch-accent">accent</span>
                <span class="swatch swatch-accent2">accent-2</span>
                <span class="swatch swatch-fg">fg</span>
                <span class="swatch swatch-muted">muted</span>
                <span class="swatch swatch-border">border</span>
              </div>
            </div>
            <!-- FORM: radius, border-width, space-unit -->
            <div class="stress-card stress-form">
              <p class="mono-label">FORM</p>
              <div class="form-demo">radius · border · space</div>
            </div>
            <!-- GRADE mirror: a second .tv-graded target so the filter is visible here too -->
            <div class="stress-card stress-grade tv-graded">
              <p class="mono-label">GRADE</p>
              <span class="grade-label">saturation · contrast · brightness · warmth · grain</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Layout specimen: editorial content that exercises every token family -->
    <p class="mono-label section-label demo-label">specimen — every token, applied</p>
    <section class="hero">
      <div class="hero-content">
        <h1 class="hero-heading text-h1">The vault renders itself.</h1>
        <p class="hero-sub">
          This page is its own proof. Every colour, type choice, radius, spacing value
          and image grade you see is a live CSS custom property. Open the tweaks panel
          and drag a slider — the system redraws in front of you.
        </p>
        <div class="cta-row">
          <button class="cta-primary">drag a slider →</button>
          <a class="cta-secondary" href="#" onclick="document.querySelector('.tv-btn--download')?.click();return false">export the css</a>
        </div>
      </div>
      <div class="hero-image-slot tv-graded">
        <div class="hero-pos-target">
          <div class="hero-placeholder">
            <span class="placeholder-text">grade target</span>
            <span class="placeholder-sub">saturation · contrast · warmth · grain · scale</span>
          </div>
        </div>
      </div>
    </section>

    <section class="body-section">
      <div class="body-content">
        <div class="editorial-grid">
          <div class="editorial-main">
            <h2 class="section-heading text-h1" style="font-size: var(--tv-h1-size);">Why tokens, not templates.</h2>
            <p>
              A template gives you a finished look. A token system gives you the
              decisions behind that look — separated from the markup, editable in
              isolation, and portable to any project that reads CSS custom properties.
            </p>
            <p>
              Drag the accent hue and every swatch, button, link, and grade filter on
              this page follows. Change the body size and the running text rescales
              without touching the heading. That is the point: the system is the
              source of truth, not the page.
            </p>
            <blockquote class="pull-quote">
              The token is the decision. The page is just where the decision lands.
            </blockquote>
            <p>
              When the system looks right, export the CSS. The tokens travel into your
              project as a single stylesheet — no build step, no runtime, no dependency.
              Paste it into the generated frontend and it inherits every decision.
            </p>
          </div>
          <aside class="editorial-aside">
            <div class="aside-block">
              <p class="mono-label">type</p>
              <p class="aside-demo aside-type">Aa</p>
              <p class="aside-meta">heading: var(--tv-font-heading) · body: var(--tv-font-body)</p>
            </div>
            <div class="aside-block">
              <p class="mono-label">radius</p>
              <div class="aside-radius-demo"></div>
              <p class="aside-meta">var(--tv-radius) · var(--tv-border-width)</p>
            </div>
            <div class="aside-block">
              <p class="mono-label">spacing</p>
              <div class="aside-spacing-demo">
                <span></span><span></span><span></span><span></span>
              </div>
              <p class="aside-meta">unit: var(--tv-space-unit)</p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="reference-footer">
      <div class="footer-content">
        <p class="mono-label">taste-vault · reference · schema v1</p>
      </div>
    </footer>
  </div>

  <!-- The tweaks panel — client:idle so it doesn't block LCP -->
  <TweaksPanel client:idle />
</Base>

<style>
  /* --- orientation header: tells a first-time visitor what this page is --- */
  .page-intro {
    background: var(--tv-bg);
    color: var(--tv-fg);
    font-family: var(--tv-font-body);
    padding: calc(var(--tv-space-unit) * 8) calc(var(--tv-space-unit) * 8)
      calc(var(--tv-space-unit) * 4);
    display: flex;
    flex-direction: column;
    gap: calc(var(--tv-space-unit) * 2);
  }
  .page-intro-title {
    font-family: var(--tv-font-heading);
    font-weight: var(--tv-h1-weight);
    letter-spacing: var(--tv-h1-tracking);
    line-height: var(--tv-h1-leading);
    margin: 0;
  }
  .page-intro-sub {
    color: var(--tv-fg-muted);
    max-width: var(--tv-measure);
    margin: 0;
  }

  /* numbered step labels for the three page sections */
  .section-label {
    margin-bottom: calc(var(--tv-space-unit) * 2);
  }
  .demo-label {
    padding: 0 calc(var(--tv-space-unit) * 8);
    margin-top: calc(var(--tv-space-unit) * 6);
  }

  .variation-section {
    padding: 0 calc(var(--tv-space-unit) * 8) calc(var(--tv-space-unit) * 4);
    background: var(--tv-bg);
  }

  .reference-page {
    min-height: 100vh;
    background: var(--tv-bg);
    color: var(--tv-fg);
    font-family: var(--tv-font-body);
    font-size: var(--tv-body-size);
    line-height: var(--tv-body-leading);
  }

  .hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    min-height: auto;
    padding: calc(var(--tv-space-unit) * 6) 0;
    gap: calc(var(--tv-space-unit) * 6);
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(var(--tv-space-unit) * 3);
  }

  .hero-heading {
    font-family: var(--tv-font-heading);
    font-weight: var(--tv-h1-weight);
    letter-spacing: var(--tv-h1-tracking);
    line-height: var(--tv-h1-leading);
    max-width: var(--tv-measure);
  }

  .hero-sub {
    color: var(--tv-fg-muted);
    max-width: var(--tv-measure);
  }

  .cta-row {
    display: flex;
    gap: calc(var(--tv-space-unit) * 4);
    align-items: center;
    margin-top: calc(var(--tv-space-unit) * 2);
  }

  .cta-primary {
    background: var(--tv-accent);
    color: var(--tv-bg);
    border: var(--tv-border-width) solid var(--tv-accent);
    border-radius: var(--tv-radius);
    padding: calc(var(--tv-space-unit) * 3) calc(var(--tv-space-unit) * 5);
    font-family: var(--tv-font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .cta-primary:hover { opacity: 0.85; }

  .cta-secondary {
    color: var(--tv-fg-muted);
    text-decoration: none;
    font-family: var(--tv-font-mono);
    font-size: 0.875rem;
    border-bottom: var(--tv-border-width) solid var(--tv-border);
    padding-bottom: calc(var(--tv-space-unit) * 1);
  }

  /* [FIX] Hero image slot now carries a rich accent gradient so the grade
     filter (saturate/contrast/brightness/hue-rotate) has real colour to act on
     instead of a flat surface grey. Background is built from accent + accent-2
     so it ALSO reacts to the Color tokens. */
  .hero-image-slot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border: var(--tv-border-width) dashed var(--tv-border);
    border-radius: var(--tv-radius);
    /* two-stop gradient using live color tokens → reacts to accent/accent-2 drag */
    background:
      radial-gradient(120% 120% at 30% 20%, var(--tv-accent) 0%, transparent 55%),
      radial-gradient(120% 120% at 80% 80%, var(--tv-accent-2) 0%, transparent 60%),
      var(--tv-surface);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    max-height: 400px;
  }

  /* [FIX] IMAGE TOKENS WERE NO-OPS HERE (no <img> existed). Now this inner
     target consumes the image tokens directly:
       - hero-pos-x / hero-pos-y → translate the content around the slot
       - hero-scale               → scale the content up/down
     This is what tokens.css does for a real <img> (object-position + scale);
     here we mirror it with transform so the placeholder also moves. */
  .hero-pos-target {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    transform:
      translate(calc((var(--tv-hero-pos-x) - 50%) * 1), calc((var(--tv-hero-pos-y) - 50%) * 1))
      scale(var(--tv-hero-scale));
    transition: transform 0.05s linear;
  }

  .hero-placeholder {
    display: flex;
    flex-direction: column;
    gap: calc(var(--tv-space-unit) * 1);
    text-align: center;
    color: var(--tv-fg);
    background: color-mix(in srgb, var(--tv-bg) 80%, transparent);
    border: var(--tv-border-width) solid var(--tv-bg);
    border-radius: var(--tv-radius);
    padding: calc(var(--tv-space-unit) * 3) calc(var(--tv-space-unit) * 5);
  }
  .placeholder-text {
    font-family: var(--tv-font-mono);
    font-size: 1rem;
    letter-spacing: 0.15em;
  }
  .placeholder-sub {
    font-family: var(--tv-font-mono);
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .mono-label {
    font-family: var(--tv-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--tv-fg-muted);
    margin: 0;
  }

  .body-section {
    padding: calc(var(--tv-space-unit) * 8);
  }

  .body-content {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-heading {
    font-family: var(--tv-font-heading);
    font-weight: var(--tv-h1-weight);
    letter-spacing: var(--tv-h1-tracking);
    line-height: var(--tv-h1-leading);
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: minmax(0, 2.5fr) minmax(0, 1fr);
    gap: calc(var(--tv-space-unit) * 12);
    align-items: start;
    margin-top: calc(var(--tv-space-unit) * 6);
  }

  .editorial-main {
    max-width: var(--tv-measure);
  }
  .editorial-main p {
    color: var(--tv-fg-muted);
    margin-bottom: calc(var(--tv-space-unit) * 4);
    line-height: var(--tv-body-leading);
  }

  .pull-quote {
    margin: calc(var(--tv-space-unit) * 6) 0;
    padding-left: calc(var(--tv-space-unit) * 5);
    border-left: var(--tv-border-width) solid var(--tv-accent);
    font-family: var(--tv-font-heading);
    font-size: calc(var(--tv-body-size) * 1.4);
    line-height: var(--tv-h1-leading);
    color: var(--tv-fg);
  }

  .editorial-aside {
    display: flex;
    flex-direction: column;
    gap: calc(var(--tv-space-unit) * 6);
    position: sticky;
    top: calc(var(--tv-space-unit) * 6);
  }

  .aside-block {
    border: var(--tv-border-width) solid var(--tv-border);
    border-radius: var(--tv-radius);
    background: var(--tv-surface);
    padding: calc(var(--tv-space-unit) * 5);
    display: flex;
    flex-direction: column;
    gap: calc(var(--tv-space-unit) * 3);
  }

  .aside-demo {
    margin: 0;
  }
  .aside-type {
    font-family: var(--tv-font-heading);
    font-size: calc(var(--tv-h1-size) * 0.67);
    font-weight: var(--tv-h1-weight);
    line-height: 1;
    color: var(--tv-fg);
  }

  .aside-radius-demo {
    width: 100%;
    height: 3rem;
    background: var(--tv-accent);
    border-radius: var(--tv-radius);
    border: var(--tv-border-width) solid var(--tv-border);
  }

  .aside-spacing-demo {
    display: flex;
    align-items: flex-end;
    gap: var(--tv-space-unit);
    height: 3rem;
  }
  .aside-spacing-demo span {
    display: block;
    width: calc(var(--tv-space-unit) * 4);
    background: var(--tv-fg-muted);
  }
  .aside-spacing-demo span:nth-child(1) { height: 40%; }
  .aside-spacing-demo span:nth-child(2) { height: 60%; }
  .aside-spacing-demo span:nth-child(3) { height: 80%; }
  .aside-spacing-demo span:nth-child(4) { height: 100%; }

  .aside-meta {
    margin: 0;
    font-family: var(--tv-font-mono);
    font-size: 0.6875rem;
    color: var(--tv-fg-muted);
    line-height: 1.4;
  }

  /* --- TOKEN STRESS TEST --- */
  .stress-block {
    margin: calc(var(--tv-space-unit) * 8) 0;
  }
  .stress-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: calc(var(--tv-space-unit) * 4);
  }
  .stress-card {
    border: var(--tv-border-width) solid var(--tv-border);
    border-radius: var(--tv-radius);
    background: var(--tv-surface);
    padding: calc(var(--tv-space-unit) * 4);
    display: flex;
    flex-direction: column;
    gap: calc(var(--tv-space-unit) * 3);
    min-height: 8rem;
  }
  /* COLOR: live swatches, one per color token */
  .swatch-row { display: flex; flex-wrap: wrap; gap: calc(var(--tv-space-unit) * 1); }
  .swatch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 2.5rem;
    font-family: var(--tv-font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: calc(var(--tv-radius) * 0.7);
    border: var(--tv-border-width) solid var(--tv-border);
  }
  .swatch-accent  { background: var(--tv-accent);   color: var(--tv-bg); }
  .swatch-accent2 { background: var(--tv-accent-2); color: var(--tv-fg); }
  .swatch-fg      { background: var(--tv-fg);       color: var(--tv-bg); }
  .swatch-muted   { background: var(--tv-fg-muted); color: var(--tv-bg); }
  .swatch-border  { background: var(--tv-border);   color: var(--tv-fg); }

  /* FORM: radius, border-width, space-unit all hit this one element */
  .form-demo {
    border: var(--tv-border-width) solid var(--tv-accent);
    border-radius: var(--tv-radius);
    padding: calc(var(--tv-space-unit) * 3) calc(var(--tv-space-unit) * 4);
    background: var(--tv-bg);
    color: var(--tv-fg);
    font-family: var(--tv-font-mono);
    font-size: 0.75rem;
    align-self: flex-start;
  }

  /* GRADE mirror: another .tv-graded target with a colourful fill so the grade
     filter + grain show up in the body too, not just the hero. */
  .stress-grade {
    background:
      linear-gradient(135deg, var(--tv-accent) 0%, var(--tv-accent-2) 100%);
    color: var(--tv-fg);
    justify-content: center;
    align-items: center;
    text-align: center;
  }
  .grade-label {
    font-family: var(--tv-font-mono);
    font-size: 0.6875rem;
    line-height: 1.4;
    max-width: 90%;
  }

  .reference-footer {
    border-top: var(--tv-border-width) solid var(--tv-border);
    padding: calc(var(--tv-space-unit) * 4) calc(var(--tv-space-unit) * 8);
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      padding: calc(var(--tv-space-unit) * 4);
    }
    .editorial-grid {
      grid-template-columns: 1fr;
      gap: calc(var(--tv-space-unit) * 8);
    }
    .editorial-aside {
      position: static;
    }
    .stress-grid {
      grid-template-columns: 1fr;
    }
    .page-intro,
    .variation-section,
    .demo-label {
      padding-left: calc(var(--tv-space-unit) * 4);
      padding-right: calc(var(--tv-space-unit) * 4);
    }
    .body-section {
      padding: calc(var(--tv-space-unit) * 4);
    }
  }
</style>
