{
  "schemaVersion": 1,
  "groups": [
    { "id": "typography", "label": "Typography", "order": 1 },
    { "id": "color", "label": "Color", "order": 2 },
    { "id": "image", "label": "Image", "order": 3 },
    { "id": "grade", "label": "Grade", "order": 4 },
    { "id": "form", "label": "Form", "order": 5 },
    { "id": "motion", "label": "Motion", "order": 6 }
  ],
  "tokens": [
    { "name": "--tv-font-heading", "group": "typography", "label": "Heading Face", "control": "select", "type": "fontStack", "default": "\"Inter Tight\", sans-serif", "themeKey": "font-heading", "description": "Display face" },
    { "name": "--tv-font-body", "group": "typography", "label": "Body Face", "control": "select", "type": "fontStack", "default": "\"Inter\", sans-serif", "themeKey": "font-body" },
    { "name": "--tv-font-mono", "group": "typography", "label": "Mono Face", "control": "select", "type": "fontStack", "default": "\"JetBrains Mono\", monospace", "themeKey": "font-mono" },

    { "name": "--tv-h1-size", "group": "typography", "label": "H1 Size", "control": "slider", "type": "length", "default": "4.5rem", "min": 1.5, "max": 9, "step": 0.125, "unit": "rem", "themeKey": "text-h1" },
    { "name": "--tv-h1-weight", "group": "typography", "label": "H1 Weight", "control": "slider", "type": "number", "default": "700", "min": 100, "max": 900, "step": 100, "themeKey": null },
    { "name": "--tv-h1-tracking", "group": "typography", "label": "H1 Tracking", "control": "slider", "type": "length", "default": "-0.02em", "min": -0.08, "max": 0.08, "step": 0.005, "unit": "em", "themeKey": "tracking-h1" },
    { "name": "--tv-h1-leading", "group": "typography", "label": "H1 Leading", "control": "slider", "type": "number", "default": "1.05", "min": 0.85, "max": 1.6, "step": 0.01, "themeKey": "leading-h1" },
    { "name": "--tv-body-size", "group": "typography", "label": "Body Size", "control": "slider", "type": "length", "default": "1rem", "min": 0.75, "max": 1.5, "step": 0.0625, "unit": "rem", "themeKey": "text-body" },
    { "name": "--tv-body-leading", "group": "typography", "label": "Body Leading", "control": "slider", "type": "number", "default": "1.6", "min": 1.1, "max": 2.2, "step": 0.05, "themeKey": "leading-body" },
    { "name": "--tv-measure", "group": "typography", "label": "Measure", "control": "slider", "type": "length", "default": "68ch", "min": 40, "max": 100, "step": 1, "unit": "ch", "themeKey": null },

    { "name": "--tv-accent", "group": "color", "label": "Accent", "control": "color", "type": "color", "default": "#E8482B", "themeKey": "color-accent" },
    { "name": "--tv-accent-2", "group": "color", "label": "Accent 2", "control": "color", "type": "color", "default": "#1B4D3E", "themeKey": "color-accent-2" },
    { "name": "--tv-bg", "group": "color", "label": "Background", "control": "color", "type": "color", "default": "#0B0B0C", "themeKey": "color-bg" },
    { "name": "--tv-surface", "group": "color", "label": "Surface", "control": "color", "type": "color", "default": "#141416", "themeKey": "color-surface" },
    { "name": "--tv-fg", "group": "color", "label": "Foreground", "control": "color", "type": "color", "default": "#F2F0EC", "themeKey": "color-fg" },
    { "name": "--tv-fg-muted", "group": "color", "label": "Muted", "control": "color", "type": "color", "default": "#8A8A8E", "themeKey": "color-fg-muted" },
    { "name": "--tv-border", "group": "color", "label": "Border", "control": "color", "type": "color", "default": "#26262A", "themeKey": "color-border" },

    { "name": "--tv-hero-pos-x", "group": "image", "label": "Hero X", "control": "slider", "type": "percent", "default": "50%", "min": 0, "max": 100, "step": 1, "unit": "%", "themeKey": null },
    { "name": "--tv-hero-pos-y", "group": "image", "label": "Hero Y", "control": "slider", "type": "percent", "default": "40%", "min": 0, "max": 100, "step": 1, "unit": "%", "themeKey": null },
    { "name": "--tv-hero-scale", "group": "image", "label": "Hero Scale", "control": "slider", "type": "number", "default": "1", "min": 0.8, "max": 1.6, "step": 0.01, "themeKey": null },

    { "name": "--tv-grade-saturate", "group": "grade", "label": "Saturation", "control": "slider", "type": "number", "default": "1", "min": 0, "max": 2, "step": 0.01, "themeKey": null },
    { "name": "--tv-grade-contrast", "group": "grade", "label": "Contrast", "control": "slider", "type": "number", "default": "1", "min": 0.5, "max": 1.8, "step": 0.01, "themeKey": null },
    { "name": "--tv-grade-brightness", "group": "grade", "label": "Brightness", "control": "slider", "type": "number", "default": "1", "min": 0.5, "max": 1.5, "step": 0.01, "themeKey": null },
    { "name": "--tv-grade-warmth", "group": "grade", "label": "Warmth", "control": "slider", "type": "angle", "default": "0deg", "min": -30, "max": 30, "step": 1, "unit": "deg", "themeKey": null },
    { "name": "--tv-grade-grain", "group": "grade", "label": "Grain", "control": "slider", "type": "number", "default": "0", "min": 0, "max": 1, "step": 0.01, "themeKey": null,
      "description": "Opacity of the noise overlay on .tv-graded::after" },

    { "name": "--tv-radius", "group": "form", "label": "Radius", "control": "slider", "type": "length", "default": "0.25rem", "min": 0, "max": 2, "step": 0.0625, "unit": "rem", "themeKey": "radius-base" },
    { "name": "--tv-border-width", "group": "form", "label": "Border Width", "control": "slider", "type": "length", "default": "1px", "min": 0, "max": 4, "step": 1, "unit": "px", "themeKey": null },
    { "name": "--tv-space-unit", "group": "form", "label": "Space Unit", "control": "slider", "type": "length", "default": "0.25rem", "min": 0.125, "max": 0.5, "step": 0.0625, "unit": "rem", "themeKey": null,
      "description": "[G6] :root-only by design. Consume as raw var(--tv-space-unit). Never bind to Tailwind's --spacing." },
    { "name": "--tv-grid-gutter", "group": "form", "label": "Grid Gutter", "control": "slider", "type": "length", "default": "1.5rem", "min": 0.5, "max": 4, "step": 0.25, "unit": "rem", "themeKey": null },

    { "name": "--tv-motion-duration", "group": "motion", "label": "Duration", "control": "slider", "type": "length", "default": "200ms", "min": 0, "max": 800, "step": 25, "unit": "ms", "themeKey": null, "enabled": false },
    { "name": "--tv-motion-easing", "group": "motion", "label": "Easing", "control": "select", "type": "fontStack", "default": "cubic-bezier(.2,.8,.2,1)", "themeKey": null, "enabled": false },

    { "name": "--tv-hero-filter", "group": "grade", "label": "Hero Filter (derived)", "control": "text", "type": "fontStack",
      "default": "none", "themeKey": null, "derived": true, "exposeToGenerator": true,
      "expr": "saturate(var(--tv-grade-saturate)) contrast(var(--tv-grade-contrast)) brightness(var(--tv-grade-brightness)) hue-rotate(var(--tv-grade-warmth))",
      "description": "[G4] Pure CSS composition. The panel NEVER recomputes this in JS." },
    { "name": "--tv-hero-object-position", "group": "image", "label": "Hero Position (derived)", "control": "text", "type": "fontStack",
      "default": "50% 40%", "themeKey": null, "derived": true, "exposeToGenerator": true,
      "expr": "var(--tv-hero-pos-x) var(--tv-hero-pos-y)" }
  ]
}
